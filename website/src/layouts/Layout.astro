---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { github, collections } from '../lib/catalog';
interface Props { title?: string; description?: string; active?: string }
const { title = 'iOS Design Atlas', description = 'A visual reference for native iOS interfaces. Runnable Swift examples, captures, and observations.', active } = Astro.props;
const entries = (await getCollection('catalog')).sort((a, b) => a.data.order - b.data.order);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f5" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title === 'iOS Design Atlas' ? title : `${title} — iOS Design Atlas`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <aside class="sidebar" aria-label="Catalog navigation">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true">a<span>↗</span></span><span>iOS Design<br /><strong>Atlas</strong></span></a>
      <div class="sidebar-label">THE COLLECTION</div>
      <a class:list={['nav-overview', { selected: !active }]} href="/"><span>All examples</span><span class="count">{entries.length.toString().padStart(2, '0')}</span></a>
      <nav class="collection-nav">
        {collections(entries).map(group => <details open={group.entries.some(entry => active === entry.id)}>
          <summary>{group.name}<span>{group.entries.length}</span></summary>
          <div class="entry-nav">{group.entries.map(entry => <a href={`/examples/${entry.id}/`} aria-current={active === entry.id ? 'page' : undefined}>{entry.data.title}</a>)}</div>
        </details>)}
      </nav>
      <div class="sidebar-bottom"><span class="status-dot"></span> An evolving reference<br /><a href={github}>View on GitHub <span aria-hidden="true">↗</span></a></div>
    </aside>
    <div class="page-shell">
      <header class="topbar">
        <a class="mobile-brand" href="/">iOS Design Atlas</a>
        <span class="topbar-label">A FIELD GUIDE TO NATIVE INTERFACES</span>
        <form action="/" class="global-search" role="search">
          <span aria-hidden="true">⌕</span>
          <input type="search" name="q" placeholder="Search patterns, APIs…" aria-label="Search the catalog" id="site-search" autocomplete="off" />
          <kbd aria-hidden="true">⌘ K</kbd>
        </form>
        <a class="github-link" href={github}>Source <span aria-hidden="true">↗</span></a>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>iOS Design Atlas</span><span>Observe. Compare. Build.</span><a href={`${github}/tree/main/catalog`}>Contribute an example ↗</a></footer>
    </div>
    <script>
      document.addEventListener('keydown', event => {
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault(); document.querySelector<HTMLInputElement>('#site-search')?.focus();
        }
      });
    </script>
  </body>
</html>
